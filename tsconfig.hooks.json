{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "jsxFactory": "h",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "claude-code": ["./types/claude-code.d.ts"]
    }
  },
  "include": ["plugins/agent-effort/hooks", "plugins/agent-effort/src", "plugins/agent-effort/contract.d.ts", "types"]
}
